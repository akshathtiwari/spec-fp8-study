# results/ is committed — it is ~1.5MB and every finding cites it
# (see docs/data-model.md). Only transient scratch is ignored.
results/**/*.tmp
# The harness's scratch log directory at repo root. NOT results/logs/,
# which is persisted evidence and must ship: check_provenance.py requires a
# cited cell to have its engine log, and a bare "logs/" pattern excluded
# them, so the audit passed locally and failed on a fresh clone.
/logs/
*.pyc
__pycache__/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
models/
.venv/

# LaTeX engine binary, fetched by paper/build.sh; not source.
paper/build/tectonic
paper/build/*.pdf
paper/*.aux
paper/*.out
paper/*.log

# docx review copy is derived; rebuild with paper/build-docx.sh
paper/build/paper-docx.tex

# Generated by paper/build.sh from canonical source; never a stored copy.
paper/build/arxiv/
paper/arxiv-submission.tar.gz
